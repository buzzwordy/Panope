{
  "name": "panope",
  "version": "3.1.0",
  "description": "Panope - a desktop and in-cluster client for Kubernetes",
  "author": "buzzwordy <buzzwordy@users.noreply.github.com>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/buzzwordy/Panope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzzwordy/Panope.git"
  },
  "bugs": {
    "url": "https://github.com/buzzwordy/Panope/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:appimage": "electron-vite build && electron-builder --linux AppImage",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "dist:rpm": "electron-vite build && electron-builder --linux rpm",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:portable": "electron-vite build && electron-builder --win portable",
    "build:server": "tsc -p tsconfig.server.json",
    "serve": "npm run build && npm run build:server && node out/server/server/index.js",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@kubernetes/client-node": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "jose": "^6.2.4",
    "js-yaml": "^4.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
